<% const p = site.data.profile; const published = p.publications.filter(item => item.status === "published"); %>
<section id="contact" class="contact-section reveal"><div class="contact-grid"><div><h2>Let’s connect<span>.</span></h2><p><%= p.contact.message %></p><a class="contact-email" href="mailto:<%= p.contact.email %>"><%= p.contact.email %> ↗</a></div><div class="contact-details"><span class="small-label">BASED AT</span><p><%= p.department %><br><%= p.institution %><br><%= p.location %></p><a href="https://orcid.org/<%= p.contact.orcid %>" target="_blank" rel="noopener">ORCID <%= p.contact.orcid %> ↗</a><% p.contact.links.forEach(link => { %><a href="<%= link.url %>" target="_blank" rel="noopener"><%= link.label %> ↗</a><% }); %></div></div></section>
