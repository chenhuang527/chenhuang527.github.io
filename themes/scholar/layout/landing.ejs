<% const p = site.data.profile; %>
<section class="start-screen" aria-labelledby="hero-name">
  <div class="world-status"><span>WORLD 01 · ACADEMIA</span><span aria-label="Five decorative hearts" class="hearts">♥ ♥ ♥ ♥ ♥</span><span>EXPLORATION MODE</span></div>
  <div class="start-title"><p class="game-kicker">A NEW QUESTION. A NEW ADVENTURE.</p><h1 id="hero-name"><%- partial('_partial/pixel-title', { text: p.name }) %></h1><p class="hero-role"><%= p.role %></p><p class="hero-institution"><%= p.institution %></p></div>
  <div class="start-dialog"><span class="dialog-tab">RESEARCH INTERESTS</span><p class="hero-focus"><%= p.focus %></p><p class="hero-intro"><%= p.intro %></p></div>
  <div class="start-actions"><a class="game-button" href="<%= url_for('/research.html') %>"><span aria-hidden="true">▶</span> RESEARCH</a><% if (p.cv) { %><a class="game-button cv-button" href="<%= url_for('/' + p.cv) %>" target="_blank" rel="noopener"><span aria-hidden="true">▶</span> VIEW CV</a><% } %></div>
  <div class="player-zone"><div class="player-intro"><span>PLAYER 01</span><strong><%= p.name %></strong><span class="player-level" title="Number of published journal articles">RESEARCH LV. <%= p.publications.filter(item => item.status === 'published').length %></span></div><div class="player-character"><%- partial('_partial/player') %><span class="player-shadow" aria-hidden="true"></span></div><p class="player-speech"><%= p.tagline %><span aria-hidden="true">▼</span></p></div>
</section>