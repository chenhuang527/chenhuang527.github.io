<% const chapter = {about:'PLAYER PROFILE',research:'SKILL TREE',publications:'QUEST LOG',projects:'QUESTS',teaching:'COURSES & LEVELS',contact:'SAVE POINT'}[page.section] || page.title; %>
<div class="academic-shell container"><header class="page-heading"><a class="breadcrumb" href="<%= url_for('/') %>">◀ WORLD 01</a><span class="breadcrumb-separator">/</span><span class="breadcrumb current"><%= page.title %></span><div class="page-title-row"><div><p class="eyebrow">CHAPTER <%= page.number %></p><h1><%= chapter %></h1><p class="page-subtitle"><%= page.subtitle %></p></div><span class="page-number" aria-hidden="true">★</span></div></header>
<div class="academic-window"><div class="window-bar"><span><%= page.title %></span><span aria-hidden="true">▪ ▪ ×</span></div><div class="academic-content"><% if(page.section === 'about') { %><%- partial('_partial/about') %><%- partial('_partial/education') %><% } else if(['research','publications','projects','teaching','contact'].includes(page.section)) { %><%- partial('_partial/' + page.section) %><% } %></div></div>
<a class="back-home" href="<%= url_for('/') %>">◀ RETURN TO START</a></div>