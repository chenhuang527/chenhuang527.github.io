<% const p = site.data.profile; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= p.name %> · <%= page.title || 'Academic Homepage' %></title>
  <meta name="description" content="<%= p.intro %>">
  <meta name="theme-color" content="#f7f8f4">
  <link rel="icon" href="<%= url_for('/assets/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url_for('/css/main.css') %>">
  <script src="<%= url_for('/js/main.js') %>" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="nav-shell">
      <a class="wordmark" href="<%= url_for('/#home') %>"><span class="monogram"><%= p.initials %></span><%= p.name %><span class="wordmark-dot">.</span></a>
      <button class="menu-toggle" aria-label="Open navigation" aria-controls="navigation" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
      <nav id="navigation" aria-label="Main navigation">
        <% theme.navigation.forEach(item => { %><a href="<%= url_for(item.href) %>"><%= item.label %></a><% }); %>
      </nav>
    </div>
  </header>
  <main id="main"><%- body %></main>
  <footer class="site-footer"><div><a class="footer-name" href="<%= url_for('/#home') %>"><%= p.name %>.</a><span>Research. Learning. Discovery.</span></div><p>© <%= new Date().getFullYear() %> <%= p.name %> <span>·</span> Updated <%= p.updated %></p><a href="#main">Back to top ↑</a></footer>
</body>
</html>
