<% const p = site.data.profile; const section = page.section || 'home'; %>
<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= p.name %> · <%= page.title || 'Home' %></title><meta name="description" content="<%= p.intro %>"><meta name="theme-color" content="#74cbef">
<link rel="icon" href="<%= url_for('/assets/favicon.svg') %>" type="image/svg+xml"><link rel="stylesheet" href="<%= url_for('/css/main.css') %>"><script src="<%= url_for('/js/main.js') %>" defer></script>
</head><body class="<%= section === 'home' ? 'is-home' : 'is-interior' %>" data-effects="<%= theme.effects !== false %>">
<%- partial('_partial/world') %><a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="nav-shell"><a class="wordmark" href="<%= url_for('/') %>" aria-label="<%= p.name %> — Home"><span class="menu-emblem" aria-hidden="true">✚</span><span><%= p.initials %> <small>MENU</small></span></a><button class="menu-toggle" aria-label="Open navigation" aria-controls="navigation" aria-expanded="false">☰ MENU</button><nav id="navigation" aria-label="Main navigation"><% theme.navigation.forEach(item => { %><a class="<%= section === item.key ? 'active' : '' %>" href="<%= url_for(item.href) %>" <%- section === item.key ? 'aria-current="page"' : '' %>><span class="menu-cursor" aria-hidden="true">▶</span><%= item.label %></a><% }); %></nav><span class="hud-star" aria-hidden="true">★</span></div></header>
<main id="main"><%- body %></main>
<footer class="site-footer"><span>© <%= new Date().getFullYear() %> <%= p.name %></span><span class="footer-note">STAY CURIOUS. KEEP EXPLORING.</span><div><span>Updated <%= p.updated %></span><% if(theme.effects !== false) { %><button class="motion-toggle" hidden aria-pressed="false">Pause effects</button><% } %></div></footer>
</body></html>