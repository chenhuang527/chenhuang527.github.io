<% const p = site.data.profile; const section = page.section || 'home'; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= p.name %> · <%= page.title || 'Home' %></title>
  <meta name="description" content="<%= p.intro %>">
  <meta name="theme-color" content="#090c19">
  <link rel="icon" href="<%= url_for('/assets/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url_for('/css/main.css') %>">
  <script src="<%= url_for('/js/main.js') %>" defer></script>
</head>
<body class="<%= section === 'home' ? 'is-home' : 'is-interior' %>" data-effects="<%= theme.effects !== false %>">
  <div class="cosmos" aria-hidden="true"><div class="nebula nebula-blue"></div><div class="nebula nebula-purple"></div><div class="star-texture"></div><canvas id="starfield"></canvas><div class="cosmic-grid"></div></div>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><div class="nav-shell">
    <a class="wordmark" href="<%= url_for('/') %>" aria-label="<%= p.name %> — Home"><span class="monogram"><%= p.initials %></span><span><%= p.name %><i>.</i></span></a>
    <button class="menu-toggle" aria-label="Open navigation" aria-controls="navigation" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button>
    <nav id="navigation" aria-label="Main navigation"><% theme.navigation.forEach(item => { %><a class="<%= section === item.key ? 'active' : '' %>" href="<%= url_for(item.href) %>" <%- section === item.key ? 'aria-current="page"' : '' %>><%= item.label %></a><% }); %></nav>
  </div></header>
  <main id="main"><%- body %></main>
  <footer class="site-footer"><span>© <%= new Date().getFullYear() %> <%= p.name %></span><span class="footer-note">LANGUAGE / VISION / KNOWLEDGE</span><div><span>Updated <%= p.updated %></span><% if (theme.effects !== false) { %><button class="motion-toggle" hidden aria-pressed="false">Pause effects</button><% } %></div></footer>
</body>
</html>
